    <Compile Include="..\..\src\HarnessLens.VisualStudio\Lifecycle\ServerStatusStore.cs" Link="ServerStatusStore.cs" />
    <Compile Include="..\..\src\HarnessLens.VisualStudio\Lifecycle\ServerControl.cs" Link="ServerControl.cs" />
  </ItemGroup>
</Project>
